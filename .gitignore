# Project
.workbuddy/

# Runtime data — regenerated by daily pipeline, but seed snapshots are committed
# so cloud deployment has base data immediately after deploy (avoids blank pages
# when the runtime disk is reset on redeploy). The daily pipeline overwrites these.
!data/storage/sector_rotation.db
# Keep seed sector K-lines so cloud deployment has base data on first boot.
!data/storage/parquet/index_hist/
!data/storage/parquet/index_hist/**/*.parquet
# Keep computed indicators (rs/trend) so 板块轮动监控 & 趋势验证 render on first boot.
data/storage/parquet/indicators/**
!data/storage/parquet/indicators/rs/
!data/storage/parquet/indicators/rs/**
!data/storage/parquet/indicators/trend/
!data/storage/parquet/indicators/trend/**
data/storage/parquet/fund_flow/
data/storage/experiments/
data/storage/reports/
data/storage/notification_subs.json

# Notification channel credentials — independent config, never commit
config/notification.json

# Optional second data source (Tushare) token config — never commit
config/tushare.json

# AI module LLM API credentials — independent config, never commit
config/ai_config.json
config/notification.yaml

